generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  PENDING
  RUNNING
  PAUSED
  DONE
}

model Task {
  id          String                  @id @default(uuid()) @db.Uuid
  title       String                  @db.VarChar
  description String?                 @db.VarChar
  time_spent  Unsupported("interval") @default(dbgenerated("'00:00:00'::interval"))
  started_at  DateTime?               @db.Timestamp(6)
  finished_at DateTime?               @db.Timestamp(6)
  status      TaskStatus              @default(PENDING)
  created_at  DateTime?               @default(now()) @db.Timestamp(6)
  updated_at  DateTime?               @updatedAt @db.Timestamp(6)
  user_id     String                  @db.Uuid
  user        user                    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tasks_user")

  @@map("tasks")
}

model user {
  id         String    @id @db.Uuid
  first_name String    @db.VarChar(20)
  last_name  String    @db.VarChar(255)
  email      String    @unique @db.VarChar(255)
  password   String    @db.VarChar
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)
  tasks      Task[]
}
